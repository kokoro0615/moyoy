{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyoy.invalid/schemas/fidelity-approval.schema.json",
  "title": "MOYOY cryptographically signed private fidelity approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "payload", "signature"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "approvalScope",
        "approvedAt",
        "fidelityConfig",
        "referenceRoot",
        "actualRoot",
        "frames",
        "requiredCoverage"
      ],
      "properties": {
        "decision": { "const": "approved" },
        "approvalScope": { "const": "technical-fidelity-references" },
        "approvedAt": { "type": "string", "format": "date-time" },
        "fidelityConfig": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "const": "fidelity.config.json" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "referenceRoot": { "const": ".private/references/approved" },
        "actualRoot": { "const": "artifacts/fidelity/captures/runs" },
        "frames": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reference", "sha256", "width", "height"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "reference": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "requiredCoverage": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "signerId", "payloadSha256", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "signerId": { "type": "string", "minLength": 1 },
        "payloadSha256": { "$ref": "#/$defs/sha256" },
        "value": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
